#!/bin/sh
# bupt-dev —— 北邮校园命令行工具「源码直跑」启动脚本（开发用）
#
# 注意：正式命令是项目根目录的 ./bupt（由 ./build.sh 生成的独立二进制）。
# 本脚本故意不叫 bupt，避免盖住二进制；调源码、改完立刻验证时用它。
#
# 依赖装在项目内的 .deps（由 uv pip install --target 安装，与任何 venv 无关）。
# 源码零安装，直接 PYTHONPATH 指向 src，因此不存在"包丢了"这种故障。
#
# 所有状态都在 ~/.bupt-cli（账号密码与会话），由 `bupt login` 创建。
#
# 覆盖：
#   BUPT_CLI_DEPS     依赖目录（默认 <项目>/.deps）
#   BUPT_CLI_PYTHON   指定解释器
#   BUPT_CLI_CONFIG_DIR / BUPT_CLI_CACHE_DIR  指定配置/缓存位置
set -e

SELF_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
DEPS_DIR="${BUPT_CLI_DEPS:-$SELF_DIR/.deps}"

# --- 选解释器 -------------------------------------------------------------
# 依赖是按 3.14 装的，只接受 3.14；其它版本直接报错，不做静默降级。
PY="${BUPT_CLI_PYTHON:-}"
if [ -z "$PY" ]; then
  for candidate in \
    "$HOME/.local/share/uv/python/cpython-3.14-macos-aarch64-none/bin/python3.14" \
    "$HOME/.local/share/uv/python/cpython-3.14-macos-aarch64-none/bin/python3"
  do
    if [ -x "$candidate" ]; then PY="$candidate"; break; fi
  done
fi
if [ -z "$PY" ]; then
  PY=$(command -v python3.14 2>/dev/null || true)
fi
if [ -z "$PY" ]; then
  echo "bupt-dev: 找不到 Python 3.14 解释器。" >&2
  echo "  修复：uv python install 3.14" >&2
  exit 1
fi

export PYTHONPATH="$SELF_DIR/src:$DEPS_DIR${PYTHONPATH:+:$PYTHONPATH}"

# --- 依赖自检（不自动联网安装）---------------------------------------------
if ! "$PY" -c 'import httpx, lxml' >/dev/null 2>&1; then
  echo "bupt-dev: 依赖缺失（${DEPS_DIR}）。运行一次即可修复：" >&2
  echo "  uv pip install --python '$PY' --target '$DEPS_DIR' 'httpx>=0.27.0' 'lxml>=5.0.0'" >&2
  exit 1
fi

exec "$PY" -m bupt_cli "$@"
